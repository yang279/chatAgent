PORT=3000
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# OpenAI-compatible API（OpenAI / DeepSeek / 火山方舟网关 等）
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
FAST_MODEL=gpt-4o-mini

# embedding 模式：local=本地哈希向量（无需 API）/ api=调用 OpenAI 兼容 embeddings 端点
EMBEDDING_MODE=local
EMBEDDING_MODEL=text-embedding-3-small

# 检索参数
TOP_K=6
RRF_K=60
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 建图实体抽取并发度（并行 chunk 数）
GRAPH_CONCURRENCY=4

# 图片型/扫描 PDF 的 OCR 兜底（pdf-parse 抽不到文字时逐页渲染后走视觉模型）
OCR_MAX_PAGES=20
OCR_SCALE=1.5
OCR_MAX_TOKENS=2000

# 文档解析在独立子进程运行，限制其堆内存（MB），OOM 不会拖垮 API 服务
WORKER_MAX_HEAP=1024

# 记忆压缩：到达阈值触发压缩，保留最近 N 条原文滑动窗口
CONTEXT_TOKEN_BUDGET=131072
COMPACTION_THRESHOLD=0.8
RECENT_WINDOW=4